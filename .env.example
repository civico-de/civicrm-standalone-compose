# Public host name. Caddy fetches a Let's Encrypt certificate for it.
DOMAIN=crm.example.org

# Addresses allowed to reach login, back office and APIv3, space separated.
# "0.0.0.0/0 ::/0" opens them to everyone.
ADMIN_IPS=203.0.113.0/24

# Features open to everyone, space separated, from caddy/profiles/ (see docs/profiles.md):
# forms civimail events contributions api
PUBLIC_PROFILES=forms civimail

# Image tag of civicrm/civicrm: a minor line receives its patch releases.
CIVICRM_VERSION=6.18

# Only read on the first start: language and first admin account.
CIVICRM_LANG=de_DE
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=

# Database password, generate with: openssl rand -hex 24
DB_PASSWORD=
